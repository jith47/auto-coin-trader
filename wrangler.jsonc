/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ema-scalper-bot",
	"main": "src/worker.js",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2025-09-17",
	"observability": {
		"enabled": true
	},
	"vars": {
		"DASHBOARD_PASSWORD": "greed2025@A"
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"BinanceDeltaFeed"
			]
		},
		{
			"tag": "v2",
			"deleted_classes": [
				"BinanceDeltaFeed"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ema_scalper_db",
			"database_id": "6121aac0-8ab7-4b47-ab0a-d1b61211f1d2"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	}
}