/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "scalper-assistant",
	"main": "src/worker.js",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2025-09-17",
	"observability": {
		"enabled": true
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"BinanceDeltaFeed"
			]
		},
		{
			"tag": "v2",
			"deleted_classes": [
				"BinanceDeltaFeed"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "trade_db",
			"database_id": "739e432a-f0ec-4f61-b0f2-913570686a46"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	}
}