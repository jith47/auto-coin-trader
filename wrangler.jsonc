{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "crypto-trading-bot",
	"main": "src/index.js",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2025-09-17",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "BOT_STATE",
			"id": "d8c63e9d60b2408e9755e324674473b4"
		}
	],
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	}
}