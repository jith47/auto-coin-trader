/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "crypto-hypo-bot",
	"main": "src/worker.js",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2025-09-17",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hypo_trade_db",
			"database_id": "e976ac59-d2ab-48ae-a7fb-ce7637bb9be1"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	}
}