/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "playwright-worker",
	"main": "src/worker.js",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2025-09-17",
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DELTA_FEED",
				"class_name": "BinanceDeltaFeed"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"BinanceDeltaFeed"
			]
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "trade_db",
			"database_id": "adfd9b6d-0350-478f-b4dc-5ba9c228d7f7"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	}
}